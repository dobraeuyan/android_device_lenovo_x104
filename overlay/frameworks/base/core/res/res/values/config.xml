<?xml version="1.0" encoding="utf-8"?>
<!--
     Framework resource overlay for the Lenovo Tab E10 (X104F).

-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ============ [x104] Form factor: Wi-Fi-only tablet ============ -->
    <!-- No telephony radio: not voice- nor SMS-capable. -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>

    <!-- Only the Wi-Fi network type exists on this SKU. -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
    </string-array>
    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
    </string-array>

    <!-- ============ [x104] Input / display form factor ============ -->
    <!-- No capacitive hardware keys -> software navigation bar. -->
    <bool name="config_showNavigationBar">true</bool>
    <!-- Tablet: allow all four orientations. -->
    <bool name="config_allowAllRotations">true</bool>
    <!-- 3.5 mm headset jack detected through an input event device. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>
    <!-- Touch panel can wake the device on double-tap. -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- ============ [x104] Display backlight (panel-specific) ============ -->
    <integer name="config_screenBrightnessSettingMinimum">3</integer>
    <integer name="config_screenBrightnessSettingDefault">128</integer>
    <integer name="config_screenBrightnessDoze">17</integer>
    <bool name="config_animateScreenLights">true</bool>

    <!-- ============ [x104] LiveDisplay (color temperature / calibration) ====
         All LiveDisplay color adjustment runs in HARDWARE via the MDP3 DMA_P CSC
         block (kernel mdp3_ctrl.c), served by
         vendor.lineage.livedisplay@2.0-service-sysfs:
           /sys/class/graphics/fb0/rgb          -> IDisplayColorCalibration
                                                   (RGB + Day/Night/Auto temperature)
           /sys/class/graphics/fb0/reading_mode -> IReadingEnhancement (grayscale)
         LineageHardwareManager checks HIDL before the software fallback, so no GPU
         color matrix (DisplayTransformManager) is used; config_setColorTransformAccelerated
         is therefore left at its AOSP default (false).

         config_nightDisplayAvailable MUST stay false so LiveDisplay keeps its own
         temperature modes (ColorTemperatureController requires !mNightDisplayAvailable)
         instead of deferring to AOSP Night Light. -->
    <bool name="config_nightDisplayAvailable">false</bool>

    <!-- ============ [x104] Power / thermal / battery ============ -->
    <!-- Emergency shutdown at 59C (device thermal limit). -->
    <integer name="config_shutdownBatteryTemperature">590</integer>
    <bool name="config_unplugTurnsOnScreen">true</bool>
    <!-- Enable Doze / app-standby auto power modes. -->
    <bool name="config_enableAutoPowerModes">true</bool>

    <!-- ============ [x104] Multi-user (tablet) ============ -->
    <integer name="config_multiuserMaximumUsers">4</integer>
    <bool name="config_enableMultiUserUI">true</bool>
    <!-- Removable microSD is hot-swappable. -->
    <bool name="config_hotswapCapable">true</bool>

    <!-- ============ [msm8909] Bluetooth capability ============ -->
    <bool name="config_bluetooth_le_peripheral_mode_supported">true</bool>

    <!-- ============ [msm8909] Wi-Fi (WCNSS/pronto) capability + tuning ====== -->
    <bool name="config_wifi_background_scan_support">true</bool>
    <bool name="config_wifi_batched_scan_supported">true</bool>

    <!-- ============ [msm8909] Tethering interfaces ============ -->
    <string-array translatable="false" name="config_tether_usb_regexs">
        <item>"usb\\d"</item>
        <item>"rndis\\d"</item>
    </string-array>
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>"wlan0"</item>
    </string-array>
    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>"bnep\\d"</item>
        <item>"bt-pan"</item>
    </string-array>
    <string-array translatable="false" name="config_tether_dhcp_range">
        <item>192.168.42.2</item><item>192.168.42.254</item>
        <item>192.168.43.2</item><item>192.168.43.254</item>
        <item>192.168.44.2</item><item>192.168.44.254</item>
        <item>192.168.45.2</item><item>192.168.45.254</item>
        <item>192.168.46.2</item><item>192.168.46.254</item>
        <item>192.168.47.2</item><item>192.168.47.254</item>
        <item>192.168.48.2</item><item>192.168.48.254</item>
        <item>192.168.49.2</item><item>192.168.49.254</item>
        <item>192.168.50.2</item><item>192.168.50.254</item>
        <item>192.168.51.2</item><item>192.168.51.254</item>
    </string-array>

</resources>
